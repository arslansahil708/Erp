@model List<PrimarySale>
@{
    ViewData["Title"] = "Primary Sales";
    var canCreate = User.IsInRole("Admin") || User.IsInRole("Sales");
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Primary Sales <small class="text-muted fs-6">(latest 200)</small></h4>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">+ New Primary Sale</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover table-erp bg-white">
        <thead>
            <tr>
                <th>Invoice No</th><th>Date</th><th>Customer</th><th>Store</th>
                <th class="text-end">Discount</th><th class="text-end">Total</th><th style="width:290px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.InvoiceNo</td>
                    <td>@s.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@s.Customer?.Name</td>
                    <td>@s.Store?.Name</td>
                    <td class="text-end">@s.Discount.ToString("N2")</td>
                    <td class="text-end">@s.Total.ToString("N2")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-controller="Reports" asp-action="CustomerLedger" asp-route-customerId="@s.CustomerId" asp-route-back="PrimarySales" class="btn btn-sm btn-outline-info">Ledger</a>
                        @if (canCreate)
                        {
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        }
                        @if (isAdmin)
                        {
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Yeh invoice delete karein? GL entries bhi hat jayengi.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
