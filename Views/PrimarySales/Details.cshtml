@model PrimarySale
@{
    ViewData["Title"] = "Invoice " + Model.InvoiceNo;
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Sales");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Primary Sale Invoice @Model.InvoiceNo</h4>
    <div class="no-print">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        }
        <a asp-controller="Reports" asp-action="CustomerLedger" asp-route-customerId="@Model.CustomerId" asp-route-back="PrimarySales" class="btn btn-outline-info">Customer Ledger</a>
        <a asp-action="Index" class="btn btn-outline-primary">Back to list</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>Date:</strong> @Model.Date.ToString("dd-MMM-yyyy")</div>
            <div class="col-md-5"><strong>Customer:</strong> @Model.Customer?.Code - @Model.Customer?.Name</div>
            <div class="col-md-4"><strong>Store:</strong> @Model.Store?.Name</div>
            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <div class="col-12 mt-2"><strong>Remarks:</strong> @Model.Remarks</div>
            }
        </div>
    </div>
</div>

<table class="table table-sm table-erp bg-white">
    <thead>
        <tr><th>Code</th><th>Item</th><th class="text-end">Quantity</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Item?.Code</td>
                <td>@l.Item?.Name</td>
                <td class="text-end">@l.Quantity.ToString("N2")</td>
                <td class="text-end">@l.Price.ToString("N2")</td>
                <td class="text-end">@((l.Quantity * l.Price).ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><td colspan="4">Sub Total</td><td class="text-end">@Model.SubTotal.ToString("N2")</td></tr>
        <tr><td colspan="4">Discount</td><td class="text-end">@Model.Discount.ToString("N2")</td></tr>
        <tr><td colspan="4">TOTAL (receivable)</td><td class="text-end">@Model.Total.ToString("N2")</td></tr>
    </tfoot>
</table>
