@model List<AppUser>
@{
    ViewData["Title"] = "Users";
    var currentId = (int)ViewBag.CurrentUserId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Users</h4>
    <a asp-action="Create" class="btn btn-primary">+ New User</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover table-erp bg-white">
        <thead>
            <tr><th>Username</th><th>Full Name</th><th>Role</th><th>Status</th><th style="width:100px"></th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.UserName @(u.Id == currentId ? "(aap)" : "")</td>
                    <td>@u.FullName</td>
                    <td>@u.Role</td>
                    <td>
                        @if (!u.IsActive) { <span class="badge bg-secondary">Inactive</span> }
                        else if (u.LockedUntil.HasValue && u.LockedUntil.Value > DateTime.UtcNow) { <span class="badge bg-warning text-dark">Locked</span> }
                        else { <span class="badge bg-success">Active</span> }
                    </td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="text-muted small">Roles: Admin: Full access to all modules and features..</p>
