@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    bool In(params string[] roles) => roles.Any(r => User.IsInRole(r));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZN ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a asp-controller="Home" asp-action="Index" class="brand">Nexa ERP</a>
        <span class="topbar-sub">Enterprise Resource Planning</span>
        @if (signedIn)
        {
            <span class="ms-auto d-flex align-items-center gap-2 topbar-user">
                <span>@(User.FindFirst("FullName")?.Value ?? User.Identity!.Name) (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-light">Change Password</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-light">Logout</button>
                </form>
            </span>
        }
    </header>

    <div class="shell">
        @if (signedIn)
        {
        <aside class="sidebar">
            <nav class="tree">
                <div class="tree-root">MASTER MENU</div>

                <details open>
                    <summary>General Setups</summary>
                    <ul>
                        @if (In("Admin", "Store"))
                        {
                            <li><a asp-controller="Stores" asp-action="Index">Stores</a></li>
                            <li><a asp-controller="Items" asp-action="Index">Items</a></li>
                        }
                        @if (In("Admin", "Accountant"))
                        {
                            <li><a asp-controller="Accounts" asp-action="Index">Chart of Accounts</a></li>
                            <li><a asp-controller="Employees" asp-action="Index">Employees</a></li>
                        }
                        @if (In("Admin", "Accountant", "Sales"))
                        {
                            <li><a asp-controller="Customers" asp-action="Index">Customers</a></li>
                        }
                        @if (In("Admin"))
                        {
                            <li><a asp-controller="Users" asp-action="Index">Users &amp; Roles</a></li>
                        }
                    </ul>
                </details>

                @if (In("Admin", "Accountant"))
                {
                <details>
                    <summary>Financial Accounts</summary>
                    <details>
                        <summary>Financial Reports</summary>
                        <ul>
                            <li><a asp-controller="Reports" asp-action="ExpensesDetail">Expenses detail report</a></li>
                            <li><a asp-controller="Reports" asp-action="GLReport">GL Report Form</a></li>
                        </ul>
                    </details>
                    <details>
                        <summary>Payables</summary>
                        <ul>
                            <li><a asp-controller="PettyCash" asp-action="Index">Petty Cash Entry form</a></li>
                        </ul>
                    </details>
                    <details>
                        <summary>Entries</summary>
                        <ul>
                            <li><a asp-controller="Journal" asp-action="Index">Journal Entry</a></li>
                        </ul>
                    </details>
                </details>
                }

                @if (In("Admin", "Accountant", "Sales"))
                {
                <details>
                    <summary>Account Receivable</summary>
                    <ul>
                        <li><a asp-controller="Customers" asp-action="Index">Customers</a></li>
                        @if (In("Admin", "Accountant"))
                        {
                            <li><a asp-controller="CustomerReceipts" asp-action="Index">Customer Receipts</a></li>
                        }
                        <li><a asp-controller="Reports" asp-action="CustomerLedger">Customer Ledger</a></li>
                        <li><a asp-controller="Reports" asp-action="ReceivableAging">Receivable Aging</a></li>
                    </ul>
                </details>

                <details>
                    <summary>Primary Sales</summary>
                    <ul>
                        @if (In("Admin", "Sales"))
                        {
                            <li><a asp-controller="PrimarySales" asp-action="Create">New Primary Sale</a></li>
                        }
                        <li><a asp-controller="PrimarySales" asp-action="Index">Primary Sales List</a></li>
                    </ul>
                </details>
                }

                @if (In("Admin", "Accountant", "Store"))
                {
                <details>
                    <summary>Material Management</summary>
                    @if (In("Admin", "Store"))
                    {
                    <details>
                        <summary>Definitions</summary>
                        <ul>
                            <li><a asp-controller="Stores" asp-action="Index">Stores</a></li>
                            <li><a asp-controller="OpeningBalances" asp-action="Index">Items Opening Balances</a></li>
                        </ul>
                    </details>
                    <details>
                        <summary>Entries (MM)</summary>
                        <ul>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="ProductionOrder">Production Order</a></li>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="GoodsReceive">Goods Receive Note</a></li>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="GoodsReturn">Goods Return Note</a></li>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="TransferIn">Transfer IN</a></li>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="TransferOut">Transfer Out</a></li>
                            <li><a asp-controller="StockDocuments" asp-action="Index" asp-route-type="StockAudit">Stock Audit</a></li>
                        </ul>
                    </details>
                    }
                    <details>
                        <summary>Output MM</summary>
                        <ul>
                            <li><a asp-controller="Reports" asp-action="StockBalance">Stock Balance</a></li>
                        </ul>
                    </details>
                </details>
                }

                @if (In("Admin", "Accountant", "Sales"))
                {
                <details>
                    <summary>Point of Sale</summary>
                    <details>
                        <summary>POS Entry</summary>
                        <ul>
                            @if (In("Admin", "Sales"))
                            {
                                <li><a asp-controller="Sales" asp-action="Create">New Sale</a></li>
                            }
                            <li><a asp-controller="Sales" asp-action="Index">Sales List</a></li>
                        </ul>
                    </details>
                    <details>
                        <summary>POS Reports</summary>
                        <ul>
                            <li><a asp-controller="Reports" asp-action="PosConsolidated">Consolidated Reports</a></li>
                            <li><a asp-controller="Reports" asp-action="CustomerOrderHistory">Customer Order History Report</a></li>
                            <li><a asp-controller="Reports" asp-action="DailySales">Daily Sales Report</a></li>
                            <li><a asp-controller="Reports" asp-action="DayEnd">Day End Report</a></li>
                            <li><a asp-controller="Reports" asp-action="DeliveryDispatch">Delivery Dispatch Report</a></li>
                            <li><a asp-controller="Reports" asp-action="DiscountReport">Discount Report</a></li>
                            <li><a asp-controller="Reports" asp-action="ItemWiseSale">Item Wise Sale</a></li>
                            <li><a asp-controller="Reports" asp-action="PettyCashReport">Petty Cash Report</a></li>
                            <li><a asp-controller="Reports" asp-action="SaleTransaction">Sale Transaction Report</a></li>
                            <li><a asp-controller="Reports" asp-action="TrendAnalysis">Trend Analysis Report</a></li>
                        </ul>
                    </details>
                </details>
                }

                @if (In("Admin", "Accountant"))
                {
                <details>
                    <summary>Human Resource</summary>
                    <ul>
                        <li><a asp-controller="Employees" asp-action="Index">Employees</a></li>
                        <li><a asp-controller="Payrolls" asp-action="Index">Payroll</a></li>
                    </ul>
                </details>
                }
            </nav>
        </aside>
        }

        <main class="content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
