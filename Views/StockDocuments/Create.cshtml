@model StockDocument
@{
    var type = (StockDocType)ViewBag.Type;
    var meta = (DocMeta)ViewBag.Meta;
    var stores = (List<SelectListItem>)ViewBag.Stores;
    var editor = (LineEditorModel)ViewBag.Editor;
    var isEdit = Model.Id > 0;
    var rd = new Dictionary<string, string>();
    if (isEdit) rd["id"] = Model.Id.ToString(); else rd["type"] = type.ToString();
    ViewData["Title"] = isEdit ? "Edit " + meta.Title + " " + Model.DocNo : "New " + meta.Title;
}

<h4 class="mb-1">@(isEdit ? "Edit " + meta.Title + " - " + Model.DocNo : "New " + meta.Title)</h4>
<p class="text-muted">@meta.Hint</p>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-all-route-data="rd">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Date</label>
                    <input type="date" name="Date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Store</label>
                    <select name="StoreId" class="form-select">
                        @foreach (var s in stores)
                        {
                            <option value="@s.Value" selected="@(s.Value == Model.StoreId.ToString())">@s.Text</option>
                        }
                    </select>
                </div>
                @if (meta.NeedsOther)
                {
                    <div class="col-md-5 mb-3">
                        <label class="form-label">@meta.OtherLabel</label>
                        <select name="OtherStoreId" class="form-select">
                            @foreach (var s in stores)
                            {
                                <option value="@s.Value" selected="@(s.Value == Model.OtherStoreId?.ToString())">@s.Text</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-12">
                    <label class="form-label">Remarks</label>
                    <input type="text" name="Remarks" class="form-control" value="@Model.Remarks" maxlength="300" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_LineEditor" model="editor" />

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-type="@type" class="btn btn-outline-secondary">Cancel</a>
</form>
