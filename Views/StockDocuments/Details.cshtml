@model StockDocument
@{
    var type = (StockDocType)ViewBag.Type;
    var meta = (DocMeta)ViewBag.Meta;
    ViewData["Title"] = meta.Title + " " + Model.DocNo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@meta.Title - @Model.DocNo</h4>
    <div class="no-print">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Index" asp-route-type="@type" class="btn btn-outline-primary">Back to list</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>Date:</strong> @Model.Date.ToString("dd-MMM-yyyy")</div>
            <div class="col-md-4"><strong>Store:</strong> @Model.Store?.Name</div>
            @if (meta.NeedsOther)
            {
                <div class="col-md-5"><strong>@meta.OtherLabel:</strong> @Model.OtherStore?.Name</div>
            }
            <div class="col-12 mt-2"><strong>Remarks:</strong> @Model.Remarks</div>
        </div>
    </div>
</div>

<table class="table table-sm table-erp bg-white">
    <thead>
        <tr><th>Code</th><th>Item</th><th class="text-end">Quantity</th><th class="text-end">Rate</th><th class="text-end">Amount</th></tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Item?.Code</td>
                <td>@l.Item?.Name</td>
                <td class="text-end">@l.Quantity.ToString("N2")</td>
                <td class="text-end">@l.Rate.ToString("N2")</td>
                <td class="text-end">@((l.Quantity * l.Rate).ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><td colspan="4">TOTAL</td><td class="text-end">@Model.Lines.Sum(l => l.Quantity * l.Rate).ToString("N2")</td></tr>
    </tfoot>
</table>
