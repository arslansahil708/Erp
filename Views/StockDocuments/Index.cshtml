@model List<StockDocument>
@{
    var type = (StockDocType)ViewBag.Type;
    var meta = (DocMeta)ViewBag.Meta;
    ViewData["Title"] = meta.Title;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">@meta.Title</h4>
    <a asp-action="Create" asp-route-type="@type" class="btn btn-primary">+ New</a>
</div>
<p class="text-muted">@meta.Hint</p>

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover table-erp bg-white">
        <thead>
            <tr>
                <th>Doc No</th>
                <th>Date</th>
                <th>Store</th>
                @if (meta.NeedsOther) { <th>@meta.OtherLabel</th> }
                <th>Lines</th>
                <th>Value</th>
                <th>Remarks</th>
                <th style="width:210px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.DocNo</td>
                    <td>@d.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@d.Store?.Name</td>
                    @if (meta.NeedsOther) { <td>@d.OtherStore?.Name</td> }
                    <td>@d.Lines.Count</td>
                    <td>@d.Lines.Sum(l => l.Quantity * l.Rate).ToString("N2")</td>
                    <td>@d.Remarks</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@d.Id" asp-route-type="@type" method="post" class="d-inline" onsubmit="return confirm('Yeh document delete karein?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
