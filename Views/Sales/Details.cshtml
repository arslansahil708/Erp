@model Sale
@{
    ViewData["Title"] = "Bill " + Model.BillNo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Bill @Model.BillNo</h4>
    <div class="no-print">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
        <a asp-action="Index" class="btn btn-outline-primary">Back to list</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>Date:</strong> @Model.Date.ToString("dd-MMM-yyyy HH:mm")</div>
            <div class="col-md-3"><strong>Store:</strong> @Model.Store?.Name</div>
            <div class="col-md-3"><strong>Customer:</strong> @(Model.CustomerName ?? "(Walk-in)")</div>
            <div class="col-md-3"><strong>Delivery:</strong> @(Model.IsDelivery ? "Yes" : "No")</div>
            @if (Model.IsDelivery)
            {
                <div class="col-12 mt-2"><strong>Address:</strong> @Model.DeliveryAddress</div>
            }
        </div>
    </div>
</div>

<table class="table table-sm table-erp bg-white">
    <thead>
        <tr><th>Item</th><th class="text-end">Quantity</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Item?.Name</td>
                <td class="text-end">@l.Quantity.ToString("N2")</td>
                <td class="text-end">@l.Price.ToString("N2")</td>
                <td class="text-end">@((l.Quantity * l.Price).ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><td colspan="3">Sub Total</td><td class="text-end">@Model.SubTotal.ToString("N2")</td></tr>
        <tr><td colspan="3">Discount</td><td class="text-end">@Model.Discount.ToString("N2")</td></tr>
        <tr><td colspan="3">TOTAL</td><td class="text-end">@Model.Total.ToString("N2")</td></tr>
    </tfoot>
</table>
